{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        { "id": "omarchy.menu" },
        { "id": "omarchy.workspaces" }
      ],
      "center": [
        { "id": "omarchy.indicators" },
        { "id": "omarchy.microphone" },
        { "id": "omarchy.clock", "format": "dddd HH:mm", "formatAlt": "d MMMM 'W'ww yyyy", "verticalFormat": "HH\n—\nmm" },
        { "id": "omarchy.keyboard-layout" },
        { "id": "omarchy.weather" },
        { "id": "omarchy.system-update" }
      ],
      "right": [
        { "id": "bar-orientation-tray" },
        { "id": "omarchy.tailscale" },
        { "id": "omarchy.agents" },
        { "id": "kuba.tasks", "refreshIntervalSec": 60 },
        { "id": "omarchy.bluetooth" },
        { "id": "omarchy.network" },
        { "id": "omarchy.audio" },
        { "id": "omarchy.monitor" },
        { "id": "omarchy.power" }
      ]
    }
  },
  "plugins": [
    { "id": "kuba.notifications" },
    {
      "id": "bar-orientation",
      "layouts": {
        "vertical": {
          "left": [
            { "id": "omarchy.menu" },
            { "id": "omarchy.tailscale" },
            { "id": "omarchy.agents" },
            { "id": "kuba.tasks", "refreshIntervalSec": 60 },
            { "id": "omarchy.bluetooth" },
            { "id": "omarchy.network" },
            { "id": "omarchy.audio" },
            { "id": "omarchy.monitor" },
            { "id": "omarchy.power" },
            { "id": "bar-orientation-tray", "revealDown": true }
          ],
          "center": [
            { "id": "omarchy.indicators" },
            { "id": "omarchy.microphone" },
            { "id": "omarchy.clock", "format": "dddd HH:mm", "formatAlt": "d MMMM 'W'ww yyyy", "verticalFormat": "HH\n—\nmm" },
            { "id": "omarchy.keyboard-layout" },
            { "id": "omarchy.weather" },
            { "id": "omarchy.system-update" }
          ],
          "right": [
            { "id": "omarchy.workspaces" }
          ]
        }
      }
    }
  ],
  "disabledPlugins": [
    "omarchy.notifications"
  ],
  "cloneSourceRestores": [
    "kuba.notifications"
  ]
}
