{
  "version": 1,
  "idle": {
    "screensaver": 600,
    "lock": 900
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "layout": {
      "left": [
        { "id": "omarchy.menu" },
        { "id": "omarchy.workspaces" }
      ],
      "centerBegin": [
        { "id": "omarchy.indicators" },
        { "id": "omarchy.microphone" }
      ],
      "center": [
        { "id": "omarchy.clock", "format": "dddd HH:mm", "formatAlt": "d MMMM 'W'ww yyyy", "verticalFormat": "HH\n—\nmm" }
      ],
      "centerEnd": [
        {
          "id": "omarchy.elsewhen",
          "cities": [
            { "name": "Warsaw", "zone": "Europe/Warsaw" },
            { "name": "Dubai", "zone": "Asia/Dubai" },
            { "name": "Tokyo", "zone": "Asia/Tokyo" },
            { "name": "Los Angeles", "zone": "America/Los_Angeles" },
            { "name": "New York", "zone": "America/New_York" }
          ]
        },
        { "id": "omarchy.weather" },
        { "id": "omarchy.system-update" }
      ],
      "right": [
        { "id": "omarchy.keyboard-layout" },
        { "id": "bar-orientation-tray" },
        { "id": "omarchy.tailscale" },
        { "id": "kuba.agents" },
        { "id": "kuba.tasks", "refreshIntervalSec": 60 },
        { "id": "omarchy.bluetooth" },
        { "id": "omarchy.network" },
        { "id": "omarchy.audio" },
        { "id": "omarchy.monitor" },
        { "id": "omarchy.power" }
      ]
    }
  },
  "plugins": [
    { "id": "kuba.notifications" },
    {
      "id": "bar-orientation",
      "layouts": {
        "vertical": {
          "left": [
            { "id": "omarchy.menu" },
            { "id": "omarchy.tailscale" },
            { "id": "kuba.agents" },
            { "id": "kuba.tasks", "refreshIntervalSec": 60 },
            { "id": "omarchy.bluetooth" },
            { "id": "omarchy.network" },
            { "id": "omarchy.audio" },
            { "id": "omarchy.monitor" },
            { "id": "omarchy.power" },
            { "id": "bar-orientation-tray", "revealDown": true }
          ],
          "center": [
            { "id": "omarchy.indicators" },
            { "id": "omarchy.microphone" },
            { "id": "omarchy.clock", "format": "dddd HH:mm", "formatAlt": "d MMMM 'W'ww yyyy", "verticalFormat": "HH\n—\nmm" },
            { "id": "omarchy.keyboard-layout" },
            { "id": "omarchy.weather" },
            { "id": "omarchy.system-update" }
          ],
          "right": [
            { "id": "omarchy.workspaces" }
          ]
        }
      }
    }
  ],
  "disabledPlugins": [
    "omarchy.notifications"
  ],
  "cloneSourceRestores": [
    "kuba.notifications"
  ]
}
