#!/usr/bin/env bash

set -euo pipefail

class_regex='^com\.t3tools\.T3Code$'
timeout="${T3CODE_WINDOW_TIMEOUT:-150}"
lock_file="${XDG_RUNTIME_DIR:-/tmp}/start-session-t3.lock"

exec 9>"$lock_file"
flock -n 9 || exit 0

# Focus an existing window wherever it is. A T3 process without a window is
# not a reason to wait: T3 is single-instance, so launching again reopens it.
if address="$("$HOME/.local/bin/hypr-find-client" "$class_regex" '*' 2>/dev/null)"; then
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null 2>&1 || true
  exit 0
fi

# A launch right after closing T3 hands off to the instance that is still
# shutting down and exits, so relaunch until a window appears.
deadline=$((SECONDS + timeout))
while (( SECONDS < deadline )); do
  uwsm-app -- "$HOME/.local/bin/t3code" >/dev/null 2>&1 9>&- &
  if [[ -n "$("$HOME/.local/bin/hypr-wait-client" "$class_regex" '*' 5 2>/dev/null)" ]]; then
    exit 0
  fi
done
