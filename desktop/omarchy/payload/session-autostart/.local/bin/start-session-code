#!/usr/bin/env bash

set -euo pipefail

if [[ -x "$HOME/.local/bin/vscode-sync-extensions" ]]; then
  "$HOME/.local/bin/vscode-sync-extensions" >/dev/null 2>&1 &
fi

if "$HOME/.local/bin/hypr-find-client" '^(Code|code|com\.microsoft\.VSCode)$' '3' >/dev/null 2>&1; then
  exit 0
fi

uwsm-app -- code >/dev/null 2>&1 &
"$HOME/.local/bin/hypr-wait-client" '^(Code|code|com\.microsoft\.VSCode)$' '3' 15 >/dev/null
