#!/usr/bin/env bash
# Launch the packaged T3 Code Nightly with Polish spellcheck and libsecret.
# /usr/bin/t3code-nightly already selects Wayland and reads
# ~/.config/t3code-nightly-flags.conf.
set -euo pipefail

launcher=/usr/bin/t3code-nightly
t3code_profile="${T3CODE_PROFILE_DIR:-$HOME/.config/t3code-v2}"
runtime_dir="${XDG_RUNTIME_DIR:-$HOME/.local/state/arch-hypr-bootstrap/runtime}"
mkdir -p "$runtime_dir"
chmod 700 "$runtime_dir"
single_instance_lock="$runtime_dir/t3code-$UID.lock"

if [[ ! -x "$launcher" ]]; then
  echo "T3 Code Nightly is not available. Select it in the bootstrap package review." >&2
  exit 1
fi

if [[ "${T3CODE_FORCE_NEW:-0}" != "1" ]]; then
  exec 8>"$single_instance_lock"
  flock -n 8 || exit 0
fi

"$HOME/.local/bin/electron-spellcheck-pl" "$t3code_profile" || true

# T3 Code picks its network-accessible host once at startup and falls back to
# local-only when no LAN address exists yet, which also disables Tailscale Serve.
network_ready() {
  ip -4 -o addr show up scope global 2>/dev/null |
    awk '$2 !~ /^(lo|tailscale|docker|br-|veth|virbr)/ { found = 1 } END { exit !found }' || return 1
  if command -v tailscale >/dev/null 2>&1 && systemctl is-active --quiet tailscaled.service 2>/dev/null; then
    tailscale ip -4 >/dev/null 2>&1 || return 1
  fi
}

wait_for_network() {
  local deadline=$((SECONDS + ${T3CODE_NETWORK_WAIT:-90}))
  until network_ready || ((SECONDS >= deadline)); do
    sleep 3
  done
}

wait_for_network

# Release the startup lock so T3 and its agents do not inherit it.
exec 8>&-

# A shell inside T3 exports this; it would start Electron as plain Node.
unset ELECTRON_RUN_AS_NODE
exec "$launcher" --password-store=gnome-libsecret "$@"
