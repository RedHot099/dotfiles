[Unit]
Description=Rclone OneDrive mount
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStartPre=/usr/bin/bash -lc 'mkdir -p %h/OneDrive %h/.cache/rclone/onedrive-vfs; if /usr/bin/findmnt -T %h/OneDrive >/dev/null 2>&1; then /usr/bin/fusermount3 -uz %h/OneDrive || /usr/bin/umount -l %h/OneDrive || true; fi'
ExecStart=/usr/bin/rclone mount onedrive: %h/OneDrive --config %h/.config/rclone/rclone.conf --cache-dir %h/.cache/rclone/onedrive-vfs --vfs-cache-mode full --vfs-write-back 30s --dir-cache-time 10m --poll-interval 1m --vfs-cache-max-size 20G --vfs-cache-max-age 24h --umask 022 --log-level INFO
ExecStop=/usr/bin/bash -lc 'if /usr/bin/findmnt -T %h/OneDrive >/dev/null 2>&1; then /usr/bin/fusermount3 -uz %h/OneDrive || /usr/bin/umount -l %h/OneDrive || true; fi'
Restart=on-failure
RestartSec=10
TimeoutStopSec=20

[Install]
WantedBy=graphical-session.target
