[Unit]
Description=Rclone Google Drive mount
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStartPre=/usr/bin/bash -lc 'mkdir -p %h/GoogleDrive %h/.cache/rclone/google-drive-vfs; if /usr/bin/findmnt -T %h/GoogleDrive >/dev/null 2>&1; then /usr/bin/fusermount3 -uz %h/GoogleDrive || /usr/bin/umount -l %h/GoogleDrive || true; fi'
ExecStart=/usr/bin/rclone mount gdrive: %h/GoogleDrive --config %h/.config/rclone/rclone.conf --cache-dir %h/.cache/rclone/google-drive-vfs --vfs-cache-mode full --vfs-write-back 30s --dir-cache-time 10m --poll-interval 1m --vfs-cache-max-size 20G --vfs-cache-max-age 24h --umask 022 --log-level INFO
ExecStop=/usr/bin/bash -lc 'if /usr/bin/findmnt -T %h/GoogleDrive >/dev/null 2>&1; then /usr/bin/fusermount3 -uz %h/GoogleDrive || /usr/bin/umount -l %h/GoogleDrive || true; fi'
Restart=on-failure
RestartSec=10
TimeoutStopSec=20

[Install]
WantedBy=graphical-session.target
