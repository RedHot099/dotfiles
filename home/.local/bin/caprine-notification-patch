#!/usr/bin/env node

'use strict';

const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');

const sourcePath = process.env.CAPRINE_ASAR_SOURCE ?? '/usr/lib/caprine/app.asar';
const cacheHome = process.env.XDG_CACHE_HOME ?? path.join(os.homedir(), '.cache');
const cacheDir = path.join(cacheHome, 'caprine-notification-fix');
const targetPath = path.join(cacheDir, 'app.asar');
const markerPath = path.join(cacheDir, 'source.json');
const unpackedPath = path.join(cacheDir, 'app.asar.unpacked');
const sourceUnpackedPath = `${sourcePath}.unpacked`;

const original = `function showNotification({ id, title, body, icon, silent }) {
    const image = new Image();
    image.crossOrigin = 'anonymous';
    image.src = icon;
    image.addEventListener('load', () => {
        const canvas = document.createElement('canvas');
        const context = canvas.getContext('2d');
        canvas.width = image.width;
        canvas.height = image.height;
        context.drawImage(image, 0, 0, image.width, image.height);
        electron_better_ipc_1.ipcRenderer.callMain('notification', {
            id,
            title,
            body,
            icon: canvas.toDataURL(),
            silent,
        });
    });
}`;

const patched = `function showNotification({ id, title, body, icon, silent }) {
    const image = new Image();
    const send = icon => electron_better_ipc_1.ipcRenderer.callMain('notification', {id, title, body, icon, silent});
    image.crossOrigin = 'anonymous';
    image.addEventListener('load', () => {
        const canvas = document.createElement('canvas');
        canvas.width = image.width;
        canvas.height = image.height;
        canvas.getContext('2d').drawImage(image, 0, 0, image.width, image.height);
        send(canvas.toDataURL());
    });
    image.addEventListener('error', () => send(''));
    image.src = icon;
}`;

function ensureUnpackedLink() {
  try {
    if (fs.readlinkSync(unpackedPath) === sourceUnpackedPath) {
      return;
    }
  } catch (error) {
    if (error.code !== 'ENOENT' && error.code !== 'EINVAL') {
      throw error;
    }
  }

  fs.rmSync(unpackedPath, {recursive: true, force: true});
  fs.symlinkSync(sourceUnpackedPath, unpackedPath, 'dir');
}

const sourceStat = fs.statSync(sourcePath);
const sourceIdentity = {size: sourceStat.size, mtimeMs: sourceStat.mtimeMs};

fs.mkdirSync(cacheDir, {recursive: true, mode: 0o700});

try {
  const cachedIdentity = JSON.parse(fs.readFileSync(markerPath, 'utf8'));
  if (cachedIdentity.size === sourceIdentity.size
      && cachedIdentity.mtimeMs === sourceIdentity.mtimeMs
      && fs.statSync(targetPath).isFile()) {
    ensureUnpackedLink();
    console.log(targetPath);
    process.exit(0);
  }
} catch (error) {
  if (!['ENOENT', 'SyntaxError'].includes(error.code) && !(error instanceof SyntaxError)) {
    throw error;
  }
}

const source = fs.readFileSync(sourcePath);
const originalBuffer = Buffer.from(original);
const patchOffset = source.indexOf(originalBuffer);

if (patchOffset === -1 || source.indexOf(originalBuffer, patchOffset + 1) !== -1) {
  throw new Error('Expected exactly one Caprine notification function to patch');
}

const patchedBuffer = Buffer.from(patched);
if (patchedBuffer.length > originalBuffer.length) {
  throw new Error('The notification patch is larger than the original ASAR entry');
}

patchedBuffer.copy(source, patchOffset);
source.fill(0x20, patchOffset + patchedBuffer.length, patchOffset + originalBuffer.length);

const temporaryPath = `${targetPath}.${process.pid}.tmp`;
fs.writeFileSync(temporaryPath, source, {mode: 0o600});
fs.renameSync(temporaryPath, targetPath);
ensureUnpackedLink();
fs.writeFileSync(markerPath, `${JSON.stringify(sourceIdentity)}\n`, {mode: 0o600});

console.log(targetPath);
