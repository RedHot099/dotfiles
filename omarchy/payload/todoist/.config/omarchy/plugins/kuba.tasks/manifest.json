{
  "schemaVersion": 1,
  "id": "kuba.tasks",
  "name": "Todoist Tasks",
  "version": "1.0.0",
  "author": "Kuba",
  "license": "MIT",
  "description": "Todoist tasks, search and quick actions in the Omarchy bar.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "activation": "on-demand",
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Todoist Tasks",
    "description": "Active Todoist count and a keyboard-driven task panel.",
    "category": "Productivity",
    "aliases": [
      "todoist",
      "tasks",
      "todo"
    ],
    "allowMultiple": false,
    "defaults": {
      "refreshIntervalSec": 60
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 30,
        "max": 3600,
        "step": 30,
        "defaultValue": 60
      }
    ]
  }
}
