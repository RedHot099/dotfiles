#!/usr/bin/env bash

set -euo pipefail

class_regex='^chrome-(www\.)?youtube\.com__.*$'

if "$HOME/.local/bin/hypr-find-client" "$class_regex" '3' >/dev/null 2>&1; then
  exit 0
fi

uwsm-app -- omarchy-launch-webapp 'https://youtube.com/' >/dev/null 2>&1 &
"$HOME/.local/bin/hypr-wait-client" "$class_regex" '3' 15 >/dev/null
