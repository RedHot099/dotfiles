#!/usr/bin/env bash

set -euo pipefail

if [[ $# -lt 2 || $# -gt 4 ]]; then
  echo "usage: hypr-wait-client <class-regex> <workspace-or-*> [timeout-seconds] [title-regex]" >&2
  exit 2
fi

class_regex="$1"
workspace_name="$2"
timeout_seconds="${3:-15}"
title_regex="${4:-.*}"
deadline=$((SECONDS + timeout_seconds))

while (( SECONDS < deadline )); do
  if address="$("$HOME/.local/bin/hypr-find-client" "$class_regex" "$workspace_name" "$title_regex" 2>/dev/null)"; then
    printf '%s\n' "$address"
    exit 0
  fi
  sleep 0.5
done

echo "Timed out waiting for client class=$class_regex workspace=$workspace_name" >&2
exit 0
