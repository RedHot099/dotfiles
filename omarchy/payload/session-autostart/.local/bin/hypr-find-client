#!/usr/bin/env bash

set -euo pipefail

if [[ $# -lt 1 || $# -gt 3 ]]; then
  echo "usage: hypr-find-client <class-regex> [workspace-or-*] [title-regex]" >&2
  exit 2
fi

class_regex="$1"
workspace_name="${2:-*}"
title_regex="${3:-.*}"

clients_json="$(hyprctl clients -j 2>/dev/null || true)"
if [[ -z "$clients_json" ]]; then
  exit 1
fi

jq -er \
  --arg class_regex "$class_regex" \
  --arg workspace_name "$workspace_name" \
  --arg title_regex "$title_regex" '
  first(
    .[]
    | select((.class // "") | test($class_regex; "i"))
    | select((.title // "") | test($title_regex; "i"))
    | select($workspace_name == "*" or (.workspace.name // "") == $workspace_name)
    | .address
  )
' <<<"$clients_json"
