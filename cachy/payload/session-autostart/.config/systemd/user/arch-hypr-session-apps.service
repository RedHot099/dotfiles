[Unit]
Description=Launch the selected CachyOS session applications
After=graphical-session.target wayland-session-waitenv.service
PartOf=graphical-session.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/start-arch-hypr-session-apps
RemainAfterExit=yes

[Install]
WantedBy=graphical-session.target
